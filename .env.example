# Variables de entorno — configurar en el Worker `crevess`
# (Settings → Variables and Secrets). NUNCA commitear valores reales.

# --- Worker (worker/index.ts) ---
# API key de Resend (resend.com) para enviar los correos del formulario
RESEND_API_KEY=

# Secreto de Turnstile (dash.cloudflare.com → Turnstile). Si falta, el
# Worker omite la verificación — solo aceptable en previews.
TURNSTILE_SECRET_KEY=

# Bandeja del equipo que recibe las solicitudes
# TODO: CONTENIDO CLIENTE — email de destino del formulario
CONTACT_TO_EMAIL=

# Remitente verificado en Resend (dominio propio)
CONTACT_FROM_EMAIL=

# --- Build de Next (pública por diseño, va embebida en el HTML) ---
# Site key de Turnstile — pública, no es un secreto. En Workers Builds va
# como variable de entorno de BUILD (no del Worker en runtime).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
